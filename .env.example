# Lowercase GHCR repository. Publishing uses GitHub Actions' built-in GITHUB_TOKEN.
IMAGE_REPOSITORY=ghcr.io/kyxie/ingest
IMAGE_TAG=latest

# Container identity; must match the owner of the media/state/config directories.
INGEST_UID=1000
INGEST_GID=1000

# Production paths only. Development always uses ./data-dev.
CONFIG_PATH=./config.json
CARDS_ROOT=/run/ingest/cards
# Required: replace with an existing directory on the mounted media HDD.
MEDIA_ROOT=
# Keep manifests and generated BaiduPCS-Go session state on the SSD.
STATE_ROOT=./data/state
PCS_CONFIG_ROOT=./data/pcs
