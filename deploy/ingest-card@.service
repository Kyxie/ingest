[Unit]
Description=Read-only camera card mount %I
Requires=ingest-mount-root.service
After=ingest-mount-root.service dev-%i.device
BindsTo=dev-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/ingest-card-mount mount %I
ExecStop=/usr/local/libexec/ingest-card-mount unmount %I
TimeoutStopSec=30
