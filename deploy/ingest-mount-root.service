[Unit]
Description=Shared parent mount for read-only camera cards
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/install -d -m 0755 /run/ingest/cards
ExecStart=/bin/mount --bind /run/ingest/cards /run/ingest/cards
ExecStart=/bin/mount --make-rshared /run/ingest/cards
ExecStop=/bin/umount /run/ingest/cards

[Install]
WantedBy=multi-user.target
