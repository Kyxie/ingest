#!/bin/sh
# Root-owned helper. Called only by the template service below.
set -eu
[ "$#" -eq 2 ] || exit 2
action=$1
card_device=$2
case "$card_device" in sd[a-z][0-9]|sd[a-z][0-9][0-9]|mmcblk[0-9]p[0-9]) ;; *) exit 2;; esac
card_path=/run/ingest/cards/$card_device
case "$action" in
  mount)
    [ -b "/dev/$card_device" ] || exit 1
    # Refuse fixed disks, including the SSD/HDD, even if a rule is accidentally broadened.
    lsblk -snro RM "/dev/$card_device" | grep -qx 1 || exit 1
    if findmnt -rn -S "/dev/$card_device" >/dev/null; then
      echo 'Card is already mounted elsewhere; refusing a second mount' >&2
      exit 1
    fi
    install -d -m 0755 "$card_path"
    mount -t exfat,vfat -o ro,nosuid,nodev,noexec,uid=1000,gid=1000,fmask=0137,dmask=0027 "/dev/$card_device" "$card_path"
    ;;
  unmount)
    if mountpoint -q "$card_path"; then umount "$card_path"; fi
    rmdir "$card_path" 2>/dev/null || true
    ;;
  *) exit 2;;
esac
